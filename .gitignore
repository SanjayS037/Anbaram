# ---------------------------------------------------------------
# Secrets — never commit these. Only the .example template goes up.
# ---------------------------------------------------------------
.env
.env.*
*.local
!.env.example
supabase/.env
supabase/functions/.env

# ---------------------------------------------------------------
# Dependencies and build output (recreated by npm install / build)
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Editors and OS clutter
# (shared VS Code settings/extension list are kept on purpose)
# ---------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Office lock files left behind while a .docx is open
~$*

# Claude Code personal settings
.claude/settings.local.json
