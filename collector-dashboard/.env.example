# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; this template is the only env file that gets committed.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / publishable key ONLY. Never the service_role / secret key.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudinary (photos of collection points / distribution centers).
# The cloud name and an UNSIGNED upload preset — both are safe to put here.
# Never put the Cloudinary API secret in this file.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
